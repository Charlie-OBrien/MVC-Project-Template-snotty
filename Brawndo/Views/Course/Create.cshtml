@using Brawndo_Translation
@model Brawndo_Components.Models.Course
@{
    ViewData["Title"] = @Resources.CreateCourseTitle;
    var currentLanguage = ViewContext.RouteData.Values["language"]?.ToString() ?? "en";
    var departments = ViewData["Departments"] as List<Brawndo_Components.Models.Department> ?? new List<Brawndo_Components.Models.Department>();
}

<h1>@Resources.CreateCourseTitle</h1>
<p><a asp-action="Index" asp-controller="Course" asp-route-language="@currentLanguage" class="btn btn-secondary">@Resources.BackToCourses</a></p>

<form asp-action="Create" method="post" class="mt-3" novalidate>
    @await Html.PartialAsync("_FormErrors")

    <div class="mb-3">
        <label asp-for="Title" class="form-label">@Resources.TableHeaderTitle <span aria-label="required">*</span></label>
        <input asp-for="Title" class="form-control" required aria-required="true" aria-describedby="Title-error" />
        <span id="Title-error" asp-validation-for="Title" class="text-danger d-block mt-1"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Credits" class="form-label">@Resources.TableHeaderCredits <span aria-label="required">*</span></label>
        <input asp-for="Credits" type="number" class="form-control" required aria-required="true" aria-describedby="Credits-error" />
        <span id="Credits-error" asp-validation-for="Credits" class="text-danger d-block mt-1"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DepartmentID" class="form-label">@Resources.TableHeaderDepartment <span aria-label="required">*</span></label>
        <select asp-for="DepartmentID" class="form-select" required aria-required="true" aria-describedby="DepartmentID-error">
            <option value="">@Resources.SelectDepartment</option>
            @foreach (var dept in departments)
            {
                <option value="@dept.DepartmentID">@dept.Name</option>
            }
        </select>
        <span id="DepartmentID-error" asp-validation-for="DepartmentID" class="text-danger d-block mt-1"></span>
    </div>

    <button type="submit" class="btn btn-primary">@Resources.CreateButton</button>
</form>
