@using Brawndo_Translation
@model Brawndo_Components.Models.Course
@{
    ViewData["Title"] = $"{Model?.Title}";
    var currentLanguage = ViewContext.RouteData.Values["language"]?.ToString() ?? "en";
}

<h1>@Model?.Title</h1>
<div class="mb-3">
    <a asp-action="Edit" asp-controller="Course" asp-route-id="@Model?.CourseID" asp-route-language="@currentLanguage" class="btn btn-warning">@Resources.EditButton</a>
    <a asp-action="Index" asp-controller="Course" asp-route-language="@currentLanguage" class="btn btn-secondary">@Resources.BackToCourses</a>
    <a asp-action="Index" asp-controller="Home" asp-route-language="@currentLanguage" class="btn btn-secondary">@Resources.BackToHome</a>
</div>

@if (Model != null)
{
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt>@Resources.FieldID</dt>
                <dd>@Model.CourseID</dd>
                <dt>@Resources.TableHeaderTitle</dt>
                <dd>@Model.Title</dd>
                <dt>@Resources.TableHeaderCredits</dt>
                <dd>@Model.Credits</dd>
                <dt>@Resources.TableHeaderDepartment</dt>
                <dd>@Model.DepartmentID</dd>
            </dl>
        </div>
    </div>
}
else
{
    <p>@Resources.NoCoursesFound</p>
}
