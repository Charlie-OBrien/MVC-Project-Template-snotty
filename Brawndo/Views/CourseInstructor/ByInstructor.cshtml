@using Brawndo_Translation
@{
    ViewData["Title"] = @Resources.CoursesForInstructor;
    var currentLanguage = ViewContext.RouteData.Values["language"]?.ToString() ?? "en";
    var instructor = ViewData["Instructor"] as Brawndo_Components.Models.Person;
}

<h1>@Resources.CoursesForInstructor: @instructor?.FirstName @instructor?.LastName</h1>
<div class="mb-3">
    <a asp-action="Index" asp-controller="CourseInstructor" asp-route-language="@currentLanguage" class="btn btn-secondary">Back to Assignments</a>
    <a asp-action="Index" asp-controller="Home" asp-route-language="@currentLanguage" class="btn btn-secondary">@Resources.BackToHome</a>
</div>

@if (instructor != null)
{
    <div class="alert alert-info">
        <p><strong>Instructor ID:</strong> @instructor.PersonID</p>
    </div>
}
