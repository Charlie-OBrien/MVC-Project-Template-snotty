@using Brawndo_Translation
@model Brawndo_Components.Models.Department
@{
    ViewData["Title"] = $"{Model?.Name}";
    var currentLanguage = ViewContext.RouteData.Values["language"]?.ToString() ?? "en";
}

<h1>@Model?.Name</h1>
<div class="mb-3">
    <a asp-action="Edit" asp-controller="Department" asp-route-id="@Model?.DepartmentID" asp-route-language="@currentLanguage" class="btn btn-warning">@Resources.EditButton</a>
    <a asp-action="Index" asp-controller="Department" asp-route-language="@currentLanguage" class="btn btn-secondary">@Resources.BackToDepartments</a>
    <a asp-action="Index" asp-controller="Home" asp-route-language="@currentLanguage" class="btn btn-secondary">@Resources.BackToHome</a>
</div>

@if (Model != null)
{
    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt>@Resources.FieldID</dt>
                <dd>@Model.DepartmentID</dd>
                <dt>@Resources.TableHeaderTitle</dt>
                <dd>@Model.Name</dd>
                <dt>@Resources.FieldBudget</dt>
                <dd>@Model.Budget.ToString("C")</dd>
                <dt>@Resources.FieldStartDate</dt>
                <dd>@Model.StartDate.ToString("yyyy-MM-dd")</dd>
                <dt>@Resources.FieldAdministrator</dt>
                <dd>@Model.Administrator</dd>
            </dl>
        </div>
    </div>

    @if (ViewData["Courses"] is List<Brawndo_Components.Models.Course> courses && courses.Count > 0)
    {
        <h3>@Resources.CoursesForDepartment</h3>
        <ul>
            @foreach (var course in courses)
            {
                <li>
                    <a asp-action="Details" asp-controller="Course" asp-route-id="@course.CourseID" asp-route-language="@currentLanguage">
                        @course.Title
                    </a>
                </li>
            }
        </ul>
    }
}
else
{
    <p>@Resources.PersonNotFound</p>
}
