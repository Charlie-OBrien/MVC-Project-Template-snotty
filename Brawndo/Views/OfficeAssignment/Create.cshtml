@using Brawndo_Translation
@model Brawndo_Components.Models.OfficeAssignment
@{
    ViewData["Title"] = @Resources.AssignOfficeTitle;
    var currentLanguage = ViewContext.RouteData.Values["language"]?.ToString() ?? "en";
    var instructors = ViewData["Instructors"] as List<Brawndo_Components.Models.Person> ?? new List<Brawndo_Components.Models.Person>();
}

<h1>@Resources.AssignOfficeTitle</h1>
<p><a asp-action="Index" asp-controller="OfficeAssignment" asp-route-language="@currentLanguage" class="btn btn-secondary">@Resources.BackToOfficeAssignments</a></p>

<form asp-action="Create" method="post" class="mt-3">
    @await Html.PartialAsync("_FormErrors")

    <div class="mb-3">
        <label asp-for="InstructorID" class="form-label">@Resources.InstructorsSection <span aria-label="required">*</span></label>
        <select asp-for="InstructorID" class="form-select" required aria-required="true" aria-describedby="InstructorID-error">
            <option value="">Select an Instructor</option>
            @foreach (var instr in instructors)
            {
                <option value="@instr.PersonID">@instr.FirstName @instr.LastName</option>
            }
        </select>
        <span id="InstructorID-error" asp-validation-for="InstructorID" class="text-danger d-block mt-1"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Location" class="form-label">@Resources.FieldLocation <span aria-label="required">*</span></label>
        <input asp-for="Location" class="form-control" required aria-required="true" aria-describedby="Location-error" />
        <span id="Location-error" asp-validation-for="Location" class="text-danger d-block mt-1"></span>
    </div>

    <button type="submit" class="btn btn-primary">@Resources.CreateButton</button>
</form>
