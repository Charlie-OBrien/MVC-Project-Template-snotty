@using Brawndo_Translation
@model Brawndo_Components.Models.OfficeAssignment
@{
    ViewData["Title"] = @Resources.EditOfficeTitle;
    var currentLanguage = ViewContext.RouteData.Values["language"]?.ToString() ?? "en";
}

<h1>@Resources.EditOfficeTitle</h1>
<p><a asp-action="Details" asp-controller="OfficeAssignment" asp-route-instructorId="@Model?.InstructorID" asp-route-language="@currentLanguage" class="btn btn-secondary">@Resources.BackToOfficeAssignments</a></p>

@if (Model != null)
{
    <form asp-action="Edit" method="post" class="mt-3">
        @await Html.PartialAsync("_FormErrors")
        <input type="hidden" asp-for="InstructorID" />

        <div class="mb-3">
            <label asp-for="Location" class="form-label">@Resources.FieldLocation <span aria-label="required">*</span></label>
            <input asp-for="Location" class="form-control" required aria-required="true" aria-describedby="Location-error" />
            <span id="Location-error" asp-validation-for="Location" class="text-danger d-block mt-1"></span>
        </div>

        <button type="submit" class="btn btn-primary">@Resources.SaveButton</button>
    </form>
}
else
{
    <p>@Resources.OfficeAssignmentNotFound</p>
}
